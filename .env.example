# Banco: em producao, Postgres (igual ao portfolio). Vazio = arquivo SQLite
# local (joycombo.db), bom para rodar no computador sem instalar nada.
DATABASE_URI=postgresql://user:password@host:5432/joycombo
PAYLOAD_SECRET=troque-por-uma-string-aleatoria-com-32-caracteres
NEXT_PUBLIC_SERVER_URL=https://joycombo.com.br
# Segredo do POST /revalidate (chamado pelo admin a cada "Salvar")
REVALIDATE_SECRET=troque-este-segredo

# Pixels (Meta, GA4, Google Ads) e Search Console sao configurados no admin:
# Configuracoes > Rastreamento.
